# SkillProof Configuration Template
# Copy this file to .env and fill in your values

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (MySQL 8 via Docker or local)
# Set FALLBACK_SQLITE=true to auto-fallback to SQLite if MySQL is unreachable during development
DATABASE_URL=mysql+pymysql://skillproof_user:skillproof_password@localhost:3306/skillproof_db
FALLBACK_SQLITE=true

# Anthropic Claude API Key (Required for live LLM extraction; mock fallback used if blank)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# GitHub Personal Access Token (Optional, avoids unauthenticated 60 req/hr rate limit)
GITHUB_TOKEN=

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000


